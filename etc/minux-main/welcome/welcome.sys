-- Welcome screen: shows Tux + ReMinux banner, then a prompt line at the bottom.
local imgPath    = "/etc/minux-main/welcome/tuxcc.nfp"
local bannerPath = "/etc/minux-main/welcome/mnx.nfp"

local tX, tY = term.getSize()
local img     = paintutils.loadImage(imgPath)
local banner  = paintutils.loadImage(bannerPath)

term.clear()
paintutils.drawFilledBox(1, 1, tX, tY - 2, colors.gray)
paintutils.drawImage(img, 0, 2)

if not pocket then
  paintutils.drawImage(banner, 14, 5)
  local _, mY = term.getCursorPos()
  term.setCursorPos(28, mY + 1)
  if term.isColor() then term.setTextColor(colors.white) end
  print("v" .. (_G.version or "?"))
end

-- Bottom bar: dark strip with user hint
paintutils.drawFilledBox(1, tY - 1, tX, tY, colors.black)
term.setCursorPos(1, tY - 1)
if term.isColor() then
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.gray)
end
local hint = " ReMinux  |  " .. (_G.login or "guest") .. "  |  type 'help' for commands "
write(hint)
if term.isColor() then
  term.setTextColor(colors.white)
  term.setBackgroundColor(colors.black)
end
term.setCursorPos(1, tY)
